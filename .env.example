# Connectz CCTV Platform — Environment Variables

# ============================================================================
# LOCAL DEVELOPMENT (SQLite)
# ============================================================================
# Use this for local dev. The db/ folder is gitignored so it won't be pushed.
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ============================================================================
# PRODUCTION (Supabase / Vercel)
# ============================================================================
# 1. Create a Supabase project at https://supabase.com
# 2. Run supabase/schema.sql in the Supabase SQL Editor
# 3. Replace the URL below with your Supabase connection string
#    (Supabase Dashboard → Project Settings → Database → Connection string → URI)
# 4. Replace [YOUR-PASSWORD] with your DB password
#
# DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# ============================================================================
# AUTH (NextAuth credentials provider)
# ============================================================================
# Admin login credentials — change these for your installation
ADMIN_EMAIL=connectzsalesandservices@gmail.com
ADMIN_PASSWORD=Connectz@2026

# NextAuth — generate a strong secret with: openssl rand -base64 32
# In Vercel: click "Generate" next to the value field
NEXTAUTH_SECRET=connectz-cctv-dev-secret-please-change-in-production-2026

# Public URL of the app (set to your Vercel URL after first deploy)
# Example: https://cnz-card.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# PUBLIC CLIENT-SIDE CONFIG
# ============================================================================
# WhatsApp support number (international format, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=917809465102
