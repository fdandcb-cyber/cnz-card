// CCTV Catalog + Setup Builder + Admin Inventory Platform
// Prisma schema — PostgreSQL (Supabase) compatible.
// Set DATABASE_URL env var to your Supabase connection string for production,
// or to file:./db/custom.db for local SQLite development.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Auto-detect provider based on DATABASE_URL scheme:
  //   - "file:..."            → sqlite (local dev)
  //   - "postgresql://..."    → postgresql (Supabase / Vercel Postgres / etc.)
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String? // JSON string of permissions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profiles    Profile[]
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String   @unique
  fullName  String?
  phone     String?
  roleId    String?
  role      Role?    @relation(fields: [roleId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// CATALOG TAXONOMY
// ============================================================

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  logoUrl     String?
  country     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  name            String
  modelNumber     String
  brandId         String
  brand           Brand    @relation(fields: [brandId], references: [id])
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  productType     String   // e.g. DVR, NVR, IP_CAMERA, ANALOG_CAMERA, HDD, SMPS, POE_SWITCH, CABLE, ACCESSORY
  variety         String?  // e.g. Dome, Bullet, Turret, PTZ
  technology      String?  // e.g. Analog, TVI, CVI, AHD, IP, PoE
  megapixel      String?  // e.g. 2MP, 4MP, 5MP, 8MP, 4K
  channels        Int?     // for recorders
  shortDescription String?
  longDescription String?
  keySpecs        String? // JSON
  features        String? // JSON array
  images          String? // JSON array of URLs
  videoUrl        String?
  documentUrl     String?
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pricing         Pricing?
  inventory       Inventory?
  inventoryTxns   InventoryTransaction[]
  suppliers       ProductSupplier[]
  variants        ProductVariant[]
  learning        LearningContent?
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String   // e.g. "4mm Lens", "2.8mm Lens"
  sku         String?
  attributes  String? // JSON
  priceDelta  Float   @default(0)
  stock       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pricing {
  id              String   @id @default(cuid())
  productId       String   @unique
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mrp             Float
  salePrice       Float
  dealerPrice     Float?
  purchasePrice   Float?
  gstRate         Float    @default(18)
  discountPercent Float    @default(0)
  minSellingPrice Float?
  effectiveFrom   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LearningContent {
  id          String   @id @default(cuid())
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  simpleExplanation String
  technicalDetails   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// INVENTORY
// ============================================================

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  locations   WarehouseLocation[]
  inventory    Inventory[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
}

model WarehouseLocation {
  id          String   @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  rack        String?
  shelf       String?
  bin         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inventory {
  id            String   @id @default(cuid())
  productId     String   @unique
  product       Product  @relation(fields: [productId], references: [id])
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  locationId    String?
  quantity      Int      @default(0)
  reservedQty   Int      @default(0)
  lowStockThreshold Int  @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactions  InventoryTransaction[]
}

model InventoryTransaction {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  inventoryId   String?
  inventory     Inventory? @relation(fields: [inventoryId], references: [id])
  type          String   // OPENING, PURCHASE, SALE, RETURN, DAMAGE, ADJUSTMENT, TRANSFER
  quantity      Int      // signed: +in / -out
  reference     String?
  notes         String?
  warehouseId   String?
  createdAt     DateTime @default(now())
}

model StockTransfer {
  id          String   @id @default(cuid())
  productId   String
  quantity    Int
  fromWarehouseId String
  toWarehouseId   String
  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status      String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactPerson String?
  phone       String?
  email       String?
  address     String?
  gstNumber   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    ProductSupplier[]
}

model ProductSupplier {
  id          String   @id @default(cuid())
  productId   String
  supplierId  String
  product     Product  @relation(fields: [productId], references: [id])
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  leadTimeDays Int?
  createdAt   DateTime @default(now())
}

// ============================================================
// COMPATIBILITY & CALCULATION RULES (database-driven config)
// ============================================================

model CompatibilityRule {
  id          String   @id @default(cuid())
  name        String
  ruleType    String   // CHANNEL_COUNT, RESOLUTION_SUPPORT, POE_POWER, CABLE_MATCH, RECORDER_TECH
  sourceType  String?  // e.g. IP_CAMERA
  targetType  String?  // e.g. NVR
  sourceAttr  String? // JSON: e.g. {"technology":"IP"}
  targetAttr  String? // JSON: e.g. {"channels":">=8"}
  severity    String   @default("ERROR") // ERROR, WARNING, INFO
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StorageCalculationRule {
  id            String   @id @default(cuid())
  name          String
  megapixel     String   // 2MP, 4MP, 5MP, 8MP, 4K
  codec         String   // H.264, H.265, H.265+
  bitrateMbps  Float
  fps           Int
  motionFactor  Float    @default(1.0) // for motion recording retention multiplier
  audioOverhead Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PowerCalculationRule {
  id            String   @id @default(cuid())
  name          String
  productType   String   // IP_CAMERA, ANALOG_CAMERA, DVR, NVR, POE_SWITCH
  wattage       Float
  safetyMarginPercent Float @default(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CableCalculationRule {
  id            String   @id @default(cuid())
  name          String
  cableType     String   // CAT5E, CAT6, RG59, RG6, SIAMESE
  systemType    String   // IP, ANALOG
  rollLengthM   Int      @default(305)
  wastagePercent Float   @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AccessoryRecommendationRule {
  id          String   @id @default(cuid())
  name        String
  systemType  String? // IP, ANALOG
  trigger     String? // JSON: e.g. {"cameraCount":">0"}
  accessoryCategory String?
  qtyPerCamera Float  @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// ORDERS & QUOTES
// ============================================================

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  location    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  quotes      QuoteRequest[]
}

model QuoteRequest {
  id          String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  setupConfig String   // JSON of full setup
  subtotal    Float
  discount    Float    @default(0)
  gst         Float    @default(0)
  grandTotal  Float
  installationRequirement String?
  status      String   @default("PENDING") // PENDING, REVIEWED, QUOTED, CONVERTED, REJECTED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// CONFIG (system-wide settings, demo data context)
// ============================================================

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
